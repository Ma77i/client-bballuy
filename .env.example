# Copiar a .env y completar con un proyecto Supabase de desarrollo.
# Nunca usar una clave service_role en el cliente.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
EXPO_PUBLIC_PROVIDER=supabase
# Configure the owner-managed support contact separately from repository evidence.
EXPO_PUBLIC_SUPPORT_EMAIL=
