{
  "extends": "./tsconfig.json",
  "include": [
    "app/**/*.ts", "app/**/*.tsx",
    "components/**/*.ts", "components/**/*.tsx",
    "constants/**/*.ts", "constants/**/*.tsx",
    "contexts/**/*.ts", "contexts/**/*.tsx",
    "hooks/**/*.ts", "hooks/**/*.tsx",
    "lib/**/*.ts", "lib/**/*.tsx",
    ".expo/types/**/*.ts", "expo-env.d.ts"
  ],
  "exclude": ["node_modules", "supabase/functions"]
}
